{
  "info": {
    "name": "Progetto Settimana 15 - Social Network",
    "description": "Collection per testare gli endpoint di autenticazione e utenti",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth & Utenti",
      "item": [
        {
          "name": "Register (primo utente diventa MODERATOR)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"gabriele\",\n  \"nomeCompleto\": \"Gabriele Leonardi\",\n  \"email\": \"gabriele@example.com\",\n  \"password\": \"Password123\"\n}"
            },
            "url": {
              "raw": "http://localhost:5174/api/utenti",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "5174",
              "path": [
                "api",
                "utenti"
              ]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"gabriele@example.com\",\n  \"password\": \"Password123\"\n}"
            },
            "url": {
              "raw": "http://localhost:5174/api/auth/login",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "5174",
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Get Me (profilo utente loggato)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer YOUR_JWT_TOKEN_HERE",
                "description": "Incolla il token ricevuto dal login"
              }
            ],
            "url": {
              "raw": "http://localhost:5174/api/utenti/me",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "5174",
              "path": [
                "api",
                "utenti",
                "me"
              ]
            }
          }
        },
        {
          "name": "Promuovi utente (SOLO MODERATOR)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer YOUR_JWT_TOKEN_HERE",
                "description": "Token del moderatore. Sostituisci USER_ID con l'id dell'utente da promuovere"
              }
            ],
            "url": {
              "raw": "http://localhost:5174/api/utenti/USER_ID/promuovi",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "5174",
              "path": [
                "api",
                "utenti",
                "USER_ID",
                "promuovi"
              ]
            }
          }
        }
      ]
    },
