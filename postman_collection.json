{
  "info": {
    "name": "Progetto Settimana 15 - Social Network",
    "description": "Collection per testare gli endpoint. Fai 'Login' una volta: il token viene salvato automaticamente nella variabile {{token}} e usato da tutte le richieste autenticate.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth & Utenti",
      "item": [
        {
          "name": "Register (primo utente diventa MODERATOR)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"gabriele\",\n  \"nomeCompleto\": \"Gabriele Leonardi\",\n  \"email\": \"gabriele@example.com\",\n  \"password\": \"Password123\"\n}"
            },
            "url": {
              "raw": "http://localhost:5174/api/utenti",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "5174",
              "path": [
                "api",
                "utenti"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"gabriele@example.com\",\n  \"password\": \"Password123\"\n}"
            },
            "url": {
              "raw": "http://localhost:5174/api/auth/login",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "5174",
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Salva automaticamente il token nella variabile di collection {{token}}:",
                  "// dopo un login riuscito tutte le richieste autenticate funzionano senza copia-incolla",
                  "const json = pm.response.json();",
                  "if (pm.response.code === 200 && json.accessToken) {",
                  "    pm.collectionVariables.set('token', json.accessToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Me (profilo utente loggato)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:5174/api/utenti/me",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "5174",
              "path": [
                "api",
                "utenti",
                "me"
              ]
            }
          }
        },
        {
          "name": "Promuovi utente (SOLO MODERATOR)",
          "request": {
